<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/config_item_bg"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <!-- Icon in rounded square -->
    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/widget_icon_bg_off">

        <ImageView
            android:id="@+id/config_item_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_plug"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- Text: nickname + model -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/config_item_nickname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/config_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Lampe Salon" />

        <TextView
            android:id="@+id/config_item_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/config_text_tertiary"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingTop="2dp"
            tools:text="P110" />
    </LinearLayout>

    <!-- Chevron -->
    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_chevron_right"
        android:importantForAccessibility="no" />
</LinearLayout>
